{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": ["**", "!node_modules", "!_research", "!data/beaches.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "useArrowFunction": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off"
      },
      "suspicious": {
        "noVar": "off",
        "noRedundantUseStrict": "off"
      }
    }
  }
}
